void ekf_update_{{meas.name}}(const float Z[N_MEASUREMENTS_{{meas.name|upper}}]{% if meas.num_params > 0 %}, const float param[{{ meas.num_params }}]{% endif %}, int num_iter) {
    // parameters
    {% for name in meas.param_names %}
    float {{name}} = param[{{loop.index0}}];
    {% endfor %}
    
    // gain matrices all matrices col major
    static float h[N_MEASUREMENTS_{{meas.name|upper}}];
    static float H[N_MEASUREMENTS_{{meas.name|upper}}*N_STATES];
    static float HP[N_MEASUREMENTS_{{meas.name|upper}}*N_STATES];
    static float S[N_MEASUREMENTS_{{meas.name|upper}}*N_MEASUREMENTS_{{meas.name|upper}}];
    static float S_chol[N_MEASUREMENTS_{{meas.name|upper}}*N_MEASUREMENTS_{{meas.name|upper}}];
    static float S_iDiag[N_MEASUREMENTS_{{meas.name|upper}}];
    static float K[N_STATES*N_MEASUREMENTS_{{meas.name|upper}}];

    // renaming
    float *R = ekf_R_{{meas.name}};

    // iterated ekf
    for (int iter = 0; iter < num_iter; iter++) {
        // prepare gain calculation
        // compute H
        ekf_H_{{meas.name}}(H{% if meas.num_params > 0 %}, param{% endif %});

        // compute h
        ekf_h_{{meas.name}}(h{% if meas.num_params > 0 %}, param{% endif %});

        // compute HP
        for (int i = 0; i < N_MEASUREMENTS_{{meas.name|upper}}; i++) {
            for (int j = 0; j < N_STATES; j++) {
                HP[i+j*N_MEASUREMENTS_{{meas.name|upper}}] = 0.;
                for (int k = 0; k < N_STATES; k++) {
                    HP[i+j*N_MEASUREMENTS_{{meas.name|upper}}] += H[i+k*N_MEASUREMENTS_{{meas.name|upper}}] * ekf_P_index(k,j);
                }
            }
        }

        // compute S = H*P*H' + R
        for (int i = 0; i < N_MEASUREMENTS_{{meas.name|upper}}; i++) {
            for (int j = 0; j < N_MEASUREMENTS_{{meas.name|upper}}; j++) {
                S[i+j*N_MEASUREMENTS_{{meas.name|upper}}] = 0.;
                for (int k = 0; k < N_STATES; k++) {
                    S[i+j*N_MEASUREMENTS_{{meas.name|upper}}] += H[i+k*N_MEASUREMENTS_{{meas.name|upper}}] * HP[j+k*N_MEASUREMENTS_{{meas.name|upper}}];
                }
            }
            S[i+i*N_MEASUREMENTS_{{meas.name|upper}}] += R[i];
        }

        // we have symmetric S and PHT in col major.
        // Solve K as K^T = invS * H*P, as we have columns of HP. We solve columns of K^T, which are actually rows of K
        // full state kalman update
        chol(S_chol, S, S_iDiag, N_MEASUREMENTS_{{meas.name|upper}});
        for (int i = 0; i < N_STATES; i++) {
            float k_row[N_MEASUREMENTS_{{meas.name|upper}}];
            chol_solve(S_chol, S_iDiag, N_MEASUREMENTS_{{meas.name|upper}}, (HP+(i*N_MEASUREMENTS_{{meas.name|upper}})), k_row);
            for (int j = 0; j < N_MEASUREMENTS_{{meas.name|upper}}; j++) {
                K[i + j*N_STATES] = k_row[j];
            }
        }

        // UPDATE STEP X_new = ...
        for (int i = 0; i < N_STATES; i++) {
            X_new[i] = X[i];
            for (int j = 0; j < N_MEASUREMENTS_{{meas.name|upper}}; j++) {
                X_new[i] += K[i + j*N_STATES] * (Z[j] - h[j]);
            }
        }   

        // swap X, X_new
        swap_ptr = X;
        X = X_new;
        X_new = swap_ptr;

        // normalize state
        ekf_normalize();
    }

    // UPDATE STEP JOSEPH FORMULA P_new = (I-KH)P(I-KH)' + KRK'
    // first compute (I-KH)
    static float I_KH[N_STATES*N_STATES];
    for (int i = 0; i < N_STATES; i++) {
        for (int j = 0; j < N_STATES; j++) {
            I_KH[i+j*N_STATES] = (i == j) ? 1.0 : 0.0;
            for (int k = 0; k < N_MEASUREMENTS_{{meas.name|upper}}; k++) {
                I_KH[i+j*N_STATES] -= K[i + k*N_STATES] * H[k + j*N_MEASUREMENTS_{{meas.name|upper}}];
            }
        }
    }
    // then compute P_new = (I-KH)P(I-KH)'
    for (int i = 0; i < N_STATES; i++) {
        for (int j = 0; j <= i; j++) {
            P_new[i*(i+1)/2+j] = 0.;
            for (int k = 0; k < N_STATES; k++) {
                for (int l = 0; l < N_STATES; l++) {
                    P_new[i*(i+1)/2+j] += I_KH[i+k*N_STATES] * ekf_P_index(k,l) * I_KH[j+l*N_STATES];
                }
            }
        }
    }
    
    // add KRK'
    for (int i = 0; i < N_STATES; i++) {
        for (int j = 0; j <= i; j++) {
            for (int k = 0; k < N_MEASUREMENTS_{{meas.name|upper}}; k++) {
                for (int l = 0; l < N_MEASUREMENTS_{{meas.name|upper}}; l++) {
                    P_new[i*(i+1)/2+j] += K[i + k*N_STATES] * R[k] * ((k == l) ? 1.0 : 0.0) * K[j + l*N_STATES];
                }
            }
        }
    }

    // swap P, P_new pointers
    swap_ptr = P;
    P = P_new;
    P_new = swap_ptr;
}
